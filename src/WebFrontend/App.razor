@using ShadcnBlazor.Components.Dialog
@using ShadcnBlazor.Components.Popover
@using ShadcnBlazor.Components.Sheet
@using WebFrontend.Components
@using WebFrontend.Components.Other

<PopoverProvider RepositionDebounceMilliseconds="1" />
<DialogProvider />
<SheetProvider />
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <p role="alert">You are not authorized to access this resource.</p>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1"/>
        </Found>
        <NotFound>
            <PageTitle>404 - Page Not found</PageTitle>
            <NotFound />
        </NotFound>
    </Router>
</CascadingAuthenticationState>
