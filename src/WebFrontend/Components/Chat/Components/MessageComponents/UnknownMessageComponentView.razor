@inherits ShadcnComponentBase
@using WebFrontend.Components.Chat.Models

<div class="flex flex-col gap-1 my-1">
    <span class="text-xs font-mono text-muted-foreground/60">&lt;@Component.TagName&gt;</span>
    <div class="border border-dashed border-muted-foreground/30 rounded px-3 py-2 font-mono text-xs text-muted-foreground/70 whitespace-pre-wrap">@Component.Content</div>
</div>

@code {
    [Parameter]
    public required UnknownMessageComponent Component { get; set; }
}
