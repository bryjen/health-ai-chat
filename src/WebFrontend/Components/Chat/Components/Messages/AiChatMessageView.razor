@inherits ShadcnComponentBase
@using WebFrontend.Components.Chat.Components.MessageComponents
@using WebFrontend.Components.Chat.Models

<div class="flex flex-col gap-2">
    @for (var i = 0; i < Message.Components.Count; i++)
    {
        var component = Message.Components[i];
        var isLast = i == Message.Components.Count - 1;
        switch (component)
        {
            case ThinkingMessageComponent thinking:
                <ThinkingMessageComponentView Component="@thinking" IsLast="@isLast" />
                break;
            case WebSearchMessageComponent webSearch:
                <WebSearchMessageComponentView Comp22onent="@webSearch" AccordionExpanded="false" />
                break;
            case TextMessageComponent text:
                <TextMessageComponentView Component="@text" />
                break;
            case ToolCallMessageComponent toolCall when ChatComponentState.ShowToolCalls:
                <ToolCallMessageComponentView Component="@toolCall" />
                break;
            case SymptomCreatedMessageComponent symptomCreated:
                <SymptomCreatedMessageComponentView Component="@symptomCreated" />
                break;
            case AssessmentCreatedMessageComponent assessmentCreated:
                <AssessmentCreatedMessageComponentView Component="@assessmentCreated" />
                break;
            case UnknownMessageComponent unknown when ChatComponentState.ShowUnknownTags:
                <UnknownMessageComponentView Component="@unknown" />
                break;
        }
    }
</div>

@code
{
    [Parameter]
    public required AiChatMessage Message { get; set; }

    [CascadingParameter(Name = nameof(ChatComponentState))]
    public ChatComponentState ChatComponentState { get; set; } = new();
}
