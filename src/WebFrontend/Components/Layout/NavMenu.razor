@using ShadcnBlazor.Components.DropdownMenu

@Render

@* ReSharper disable once UnusedParameter.Local *@

@code {
    private static string NavButtonClass => string.Join(" ", [
        "flex items-center w-full p-2 transition-all duration-200 ease-in-out bg-card cursor-pointer",
        "text-foreground rounded-md gap-2 no-underline",
        "hover:brightness-175"
    ]);

    private RenderFragment Render => __builder =>
    {
        <div class="h-full w-full py-8 px-4 flex flex-col">
            <div class="shink-0">
                <div class="w-full flex px-2 items-center gap-2">
                    <LuApple class="size-5" />
                    <span class="text-lg font-semibold text-foreground">Salus</span>
                </div>
            </div>

            <div class="flex-1 flex flex-col">
                <AuthorizeView>
                    <Authorized>
                        @RenderAuthorizedPanel
                    </Authorized>
                    <NotAuthorized>
                        @RenderUnauthPanel
                    </NotAuthorized>
                </AuthorizeView>
            </div>

            <div class="shrink-0">
                @RenderFooter
            </div>
        </div>
    };

    private RenderFragment RenderAuthorizedPanel => __builder =>
    {
        <div class="flex flex-col flex-1 overflow-hidden gap-2 pt-8">
            <NavLink href="/dashboard" class="@NavButtonClass">
                <LuLayoutDashboard class="size-3"/>
                <span class="text-sm">Dashboard</span>
            </NavLink>

            <NavLink href="/symptom-map" class="@NavButtonClass">
                <LuWaypoints class="size-3"/>
                <span class="text-sm">Symptom Map</span>
            </NavLink>

            <button @onclick="StartNewChat" class="@NavButtonClass">
                <LuPlus class="size-3"/>
                <span class="text-sm">New Chat</span>
            </button>

            @* recent chats section *@
            <div class="flex flex-col flex-1 overflow-hidden">
                <div class="pt-4 pb-2">
                    <h2 class="text-xs font-semibold text-muted-foreground tracking-wider">Recents</h2>
                </div>

                @RenderConversationsPanel
            </div>
        </div>
    };

    private RenderFragment RenderUnauthPanel => __builder =>
    {
        <div class="flex flex-col gap-2 pt-8">
            <NavLink href="/login" class="@NavButtonClass">
                <LuLogIn class="size-3"/>
                <span class="text-sm">Sign in</span>
            </NavLink>
            <NavLink href="/register" class="@NavButtonClass">
                <LuUserPlus class="size-3"/>
                <span class="text-sm">Create account</span>
            </NavLink>
        </div>
    };

    /// <remarks>
    /// Requires authenticated user. See caller above.
    /// </remarks>
    private RenderFragment RenderConversationsPanel => __builder =>
    {
        <div class="flex-1 overflow-y-auto pb-3">
            @if (IsLoadingConversations)
            {
                <div class="text-center py-8 text-sm text-muted-foreground">Loading...</div>
            }
            else if (FilteredConversations.Count == 0)
            {
                <div class="text-center py-8 text-sm text-muted-foreground">
                    @(string.IsNullOrWhiteSpace(SearchQuery) ? "No conversations yet" : "No conversations found")
                </div>
            }
            else
            {
                @foreach (var conversation in FilteredConversations)
                {
                    var conv = conversation;
                    <div class="relative group/item mb-1 rounded-md bg-card duration-300 transition-colors hover:brightness-175">
                        <div class="flex items-center gap-1 px-2 py-1">
                            <NavLink href="@($"/chat?conversation={conv.Id}")" class="flex-1 min-w-0">
                                <div class="text-xs font-medium text-foreground truncate">
                                    @conv.Title
                                </div>
                                @if (!string.IsNullOrWhiteSpace(conv.LastMessagePreview))
                                {
                                    <div class="text-[0.715rem] text-muted-foreground truncate mt-0.5">
                                        @conv.LastMessagePreview
                                    </div>
                                }
                            </NavLink>
                            <DropdownMenu>
                                <DropdownMenuTrigger AsChild="true">
                                    <button class="opacity-0 group-hover/item:opacity-100 transition-opacity shrink-0 flex items-center justify-center w-5 h-5 rounded hover:bg-muted text-muted-foreground hover:text-foreground">
                                        <LuEllipsis class="size-3"/>
                                    </button>
                                </DropdownMenuTrigger>
                                <DropdownMenuContent>
                                    <DropdownMenuItem
                                        Class="text-destructive focus:text-destructive cursor-pointer"
                                        OnClick="@(() => HandleDeleteConversation(conv.Id))">
                                        <LuTrash2 class="size-3 mr-2"/>
                                        Delete
                                    </DropdownMenuItem>
                                </DropdownMenuContent>
                            </DropdownMenu>
                        </div>
                    </div>
                }
            }
        </div>
    };

    private RenderFragment RenderFooter => __builder =>
    {
        <div class="flex flex-col flex-1 overflow-hidden gap-2 pt-8">
            <NavLink href="/settings" class="@NavButtonClass">
                <LuSettings class="size-3"/>
                <span class="text-sm">Settings</span>
            </NavLink>

            <NavLink href="/search" class="@NavButtonClass">
                <LuSearch class="size-3"/>
                <span class="text-sm">Search</span>
            </NavLink>

            <UserNav />
        </div>
    };
}
