@using ShadcnBlazor.Components.Avatar

@Render

@* ReSharper disable once UnusedParameter.Local *@

@code {
    private static string NavButtonClass => string.Join(" ", [
        "flex items-center w-full p-2 transition-all duration-200 ease-in-out bg-card cursor-pointer",
        "text-foreground rounded-md gap-2 no-underline",
        "hover:brightness-175"
    ]);

    private RenderFragment Render => __builder =>
    {
        <div class="h-full w-full py-8 px-4 flex flex-col">
            <div class="shink-0">
                <div class="w-full flex px-2 items-center gap-2">
                    <LuApple class="size-5" />
                    <span class="text-lg font-semibold text-foreground">Salus</span>
                </div>
            </div>

            <div class="flex-1 flex flex-col" @onclick="ToggleNavMenu">
                <AuthorizeView>
                    <Authorized>
                        @RenderAuthorizedPanel
                    </Authorized>
                </AuthorizeView>
            </div>

            <div class="shrink-0">
                @RenderFooter
            </div>
        </div>
    };

    private RenderFragment RenderAuthorizedPanel => __builder =>
    {
        <div class="flex flex-col flex-1 overflow-hidden gap-2 pt-8">
            <NavLink href="/dashboard" class="@NavButtonClass">
                <LuLayoutDashboard class="size-3"/>
                <span class="text-sm">Dashboard</span>
            </NavLink>

            <NavLink href="/symptom-map" class="@NavButtonClass">
                <LuWaypoints class="size-3"/>
                <span class="text-sm">Symptom Map</span>
            </NavLink>

            <button @onclick="StartNewChat" class="@NavButtonClass">
                <LuPlus class="size-3"/>
                <span class="text-sm">New Chat</span>
            </button>

            @* recent chats section *@
            <div class="flex flex-col flex-1 overflow-hidden">
                <div class="px-3 pt-4 pb-2">
                    <h2 class="text-xs font-semibold text-muted-foreground tracking-wider">Recents</h2>
                </div>

                @RenderConversationsPanel
            </div>
        </div>
    };

    /// <remarks>
    /// Requires authenticated user. See caller above.
    /// </remarks>
    private RenderFragment RenderConversationsPanel => __builder =>
    {
        <div class="flex-1 overflow-y-auto px-3 pb-3">

            <div class="relative group/item mb-1 rounded-md bg-card duration-300 transition-colors hover:brightness-175">
                <NavLink href="@($"/chat?conversation=test")" class="flex items-start gap-2 px-2 py-1">
                    <div class="flex-1 min-w-0 max-w-[80%]">
                        <div class="text-xs font-medium text-foreground truncate">
                            Test Conversation
                        </div>
                        <div class="text-[0.715rem] text-muted-foreground truncate mt-0.5">
                            Hello how are you doing
                        </div>
                    </div>
                </NavLink>
            </div>

            @if (IsLoadingConversations)
            {
                <div class="text-center py-8 text-sm text-muted-foreground">Loading...</div>
            }
            else if (FilteredConversations.Count == 0)
            {
                <div class="text-center py-8 text-sm text-muted-foreground">
                    @(string.IsNullOrWhiteSpace(SearchQuery) ? "No conversations yet" : "No conversations found")
                </div>
            }
            else
            {
                @foreach (var conversation in FilteredConversations)
                {
                    <div class="relative group/item mb-1 rounded-md hover:bg-accent transition-colors">
                        <NavLink
                            href="@($"/chat?conversation={conversation.Id}")"
                            class="flex items-start gap-3 p-2">
                            <svg class="w-5 h-5 text-muted-foreground mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M2.678 11.894a1 1 0 0 1 .287.801 10.97 10.97 0 0 1-.398 2c1.395-.323 2.247-.697 2.634-.893a1 1 0 0 1 .71-.074A8.06 8.06 0 0 0 8 14c3.996 0 7-2.807 7-6 0-3.192-3.004-6-7-6S1 4.808 1 8c0 1.468.617 2.83 1.678 3.894zm-.493 3.905a21.682 21.682 0 0 1-.713.129c-.2.032-.352-.176-.273-.362a9.68 9.68 0 0 0 .244-.637l.003-.01c.248-.72.45-1.548.524-2.319C.743 11.37 0 9.76 0 8c0-3.866 3.582-7 8-7s8 3.134 8 7-3.582 7-8 7a9.06 9.06 0 0 1-2.347-.306c-.52.263-1.639.742-3.468 1.105z"/>
                            </svg>
                            <div class="flex-1 min-w-0 max-w-[80%]">
                                <div class="text-sm font-medium text-foreground truncate">
                                    @conversation.Title
                                </div>
                                @if (!string.IsNullOrWhiteSpace(conversation.LastMessagePreview))
                                {
                                    <div class="text-xs text-muted-foreground truncate mt-0.5">
                                        @conversation.LastMessagePreview
                                    </div>
                                }
                            </div>
                        </NavLink>
                    </div>
                }
            }
        </div>
    };

    private RenderFragment RenderFooter => __builder =>
    {
        <div class="flex flex-col flex-1 overflow-hidden gap-2 pt-8">
            <NavLink href="/settings" class="@NavButtonClass">
                <LuSettings class="size-3"/>
                <span class="text-sm">Settings</span>
            </NavLink>

            <NavLink href="/search" class="@NavButtonClass">
                <LuSearch class="size-3"/>
                <span class="text-sm">Search</span>
            </NavLink>

            <button class="flex items-center w-full p-2 rounded-lg hover:bg-accent transition-colors text-left group cursor-pointer">
                <Avatar Size="default" Alt="John Doe" Class="border border-border">
                </Avatar>
                <div class="ml-3 flex-1 min-w-0">
                    <p class="text-sm font-medium text-foreground truncate">
                        John Doe
                    </p>
                    <p class="text-xs text-muted-foreground truncate">
                        johndoe1234@gmail.com
                    </p>
                </div>
                <LuChevronsUpDown class="ml-auto w-4 h-4 text-muted-foreground group-hover:text-foreground transition-colors" />
            </button>
        </div>
    };
}
