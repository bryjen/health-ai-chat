@page "/chat"
@using WebFrontend.Components.Chat
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Chat</PageTitle>

<div class="w-full h-full pb-4 overflow-y-hidden">
    <div class="sticky top-0 z-10 border-b border-border relative">
        <div class="absolute inset-0">
            <div class="h-12 w-full bg-gradient-to-b from-background/90 via-background/70 to-transparent"></div>
            <div class="absolute inset-0 bg-gradient-to-b from-background/60 via-background/40 to-transparent backdrop-blur-[24px]"></div>
        </div>
        <div class="absolute inset-x-0 top-0 z-20 flex h-12 items-center justify-between px-12">
            <div class="text-xs font-medium tracking-wide text-foreground/80 uppercase">Live health assistant</div>
            <div class="text-xs text-muted-foreground">Connected · Yes</div>
        </div>
    </div>

    <div class="h-full w-full px-[15vw]">
        <CascadingValue Value="@Size.Lg" Name="@nameof(Size)">
            <AiChat ConversationId="@Conversation"/>
        </CascadingValue>
    </div>
</div>
